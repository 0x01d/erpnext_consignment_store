# Consignment Store Development Environment Configuration

# Site Configuration
SITE_NAME=development.localhost
HTTP_PORT=8000

# Database Configuration
DB_ROOT_PASSWORD=admin

# Admin Configuration
ADMIN_PASSWORD=admin

# Company Information
COMPANY_NAME=Consignment Store Demo

# Frappe/ERPNext Versions
FRAPPE_BRANCH=version-15
ERPNEXT_BRANCH=version-15
ERPNEXT_VERSION=v15

# Developer Mode (1 = enabled, 0 = disabled)
DEVELOPER_MODE=1

# Redis Configuration (usually don't need to change)
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# Database Configuration (usually don't need to change)
DB_HOST=mariadb
DB_PORT=3306
